# =============================================================================
# SynapseOps — Environment Variables
# Copy this file to .env and fill in your local values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_NAME=SynapseOps
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=synapseops
POSTGRES_USER=synapseops
POSTGRES_PASSWORD=changeme_local_only

# Assembled by the application — you can override this directly:
# DATABASE_URL=postgresql+asyncpg://synapseops:changeme_local_only@localhost:5432/synapseops

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=  # Leave blank if no Redis auth

# =============================================================================
# Phase 3 — Observability & Telemetry
# =============================================================================

# --- OpenTelemetry ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=synapseops-api
OTEL_SERVICE_VERSION=0.1.0
# OTLP gRPC endpoint — point to Jaeger all-in-one in Docker Compose:
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true

# --- Prometheus ---
PROMETHEUS_ENABLED=true

# --- Grafana ---
# Default admin password — change before any non-local deployment
GRAFANA_ADMIN_PASSWORD=admin
